<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CardShopCoop</AssemblyName>
    <AssemblyTitle>CardShopCoop</AssemblyTitle>
    <RootNamespace>CardShopCoop</RootNamespace>
    <Company>Devin 'Meepen' Korb</Company>
    <Product>CardShopCoopCommunity</Product>
    <Description>CardShopCoopCommunity for TCG Card Shop Simulator.</Description>
    <Authors>Devin 'Meepen' Korb</Authors>
    <Version>$(CardShopCoopVersion)</Version>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ManagedPath>$(GamePath)/Card Shop Simulator_Data/Managed</ManagedPath>
    <BepInExPath>$(GamePath)/BepInEx/core</BepInExPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CardShopCoop.Api\CardShopCoop.Api.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(ManagedPath)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedPath)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedPath)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)CardShopCoopVersion.g.cs" />
  </ItemGroup>

  <Target Name="GenerateCardShopCoopVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <CardShopCoopGeneratedSource>// &lt;auto-generated /&gt;&#xA;namespace CardShopCoop&#xA;{&#xA;    public partial class CoopPlugin&#xA;    {&#xA;        public const string Version = &quot;$(CardShopCoopVersion)&quot;%3B&#xA;    }&#xA;}</CardShopCoopGeneratedSource>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)CardShopCoopVersion.g.cs"
      Overwrite="true"
      Lines="$(CardShopCoopGeneratedSource)" />
  </Target>

  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)CardShopCoop.Api.dll" DestinationFolder="$(DeployPath)/BepInEx/plugins/CardShopCoop" />
    <Copy SourceFiles="$(TargetDir)CardShopCoop.Api.xml"
          DestinationFolder="$(DeployPath)/BepInEx/plugins/CardShopCoop"
          Condition="Exists('$(TargetDir)CardShopCoop.Api.xml')" />
  </Target>

  <Target Name="Package" AfterTargets="Build" DependsOnTargets="BuildOptionalSteamAssembly"
          Condition="'$(Package)' == 'true'">
    <PropertyGroup>
      <PackageDirectory>$(IntermediateOutputPath)package</PackageDirectory>
      <PackageZip>$(OutputPath)$(AssemblyName).zip</PackageZip>
      <!-- The Steam transport is its OWN assembly, so it lands in ITS output directory, never in
           this project's $(TargetDir). Resolve it there under the same configuration (Release,
           Deploy, ...). -->
      <SteamAssembly>$(MSBuildThisFileDirectory)..\CardShopCoop.Steam\bin\$(Configuration)\CardShopCoop.Steam.dll</SteamAssembly>
    </PropertyGroup>
    <!-- Fail LOUDLY rather than ship a zip with no Steam transport: an earlier version copied
         $(TargetDir)CardShopCoop.Steam.dll, which never exists, and silently omitted it. -->
    <Error Condition="!Exists('$(SteamAssembly)')"
           Text="Package: CardShopCoop.Steam.dll was not found at '$(SteamAssembly)'. The zip would ship without the Steam transport; build CardShopCoop.Steam first (or use the solution)." />
    <RemoveDir Directories="$(PackageDirectory)" />
    <MakeDir Directories="$(PackageDirectory)/$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)CardShopCoop.Api.dll" DestinationFolder="$(PackageDirectory)/$(AssemblyName)" />
    <Copy SourceFiles="$(TargetDir)CardShopCoop.Api.xml"
          DestinationFolder="$(PackageDirectory)/$(AssemblyName)"
          Condition="Exists('$(TargetDir)CardShopCoop.Api.xml')" />
    <Copy SourceFiles="$(SteamAssembly)"
          DestinationFolder="$(PackageDirectory)/$(AssemblyName)" />
    <ZipDirectory SourceDirectory="$(PackageDirectory)" DestinationFile="$(PackageZip)" Overwrite="true" />
  </Target>

  <!-- The optional Steam transport is its OWN assembly (see Net/ISteamBridge.cs) and this project
       deliberately does NOT reference it, so a build here would never pull it in. Build it
       alongside so a plain `dotnet build CardShopCoop.csproj -p:Deploy=true` still produces the
       full plugin set. Steam -> core is the only project-reference direction, so there is no
       cycle: core has finished building by the time this runs. -->
  <Target Name="BuildOptionalSteamAssembly" AfterTargets="Build"
          Condition="'$(SkipOptionalSteamBuild)' != 'true' and Exists('$(MSBuildThisFileDirectory)..\CardShopCoop.Steam\CardShopCoop.Steam.csproj')">
    <!-- Restore the Steam project in its OWN process, then build it in a second invocation.
         The Steam project is deliberately NOT a ProjectReference, so the outer restore never
         covers it (a bare nested Build dies with NETSDK1004 on a clean checkout). But a
         same-invocation "Restore;Build" evaluates the project ONCE, BEFORE Restore writes the
         restored packages' generated props/targets - so the Microsoft.NETFramework.ReferenceAssemblies
         targets that supply FrameworkPathOverride are never imported, and a machine with no .NET
         Framework targeting pack (the Linux CI) dies with MSB3644. A separate process guarantees the
         restore artifacts exist before the Build's evaluation. The Exists() guard skips the restore
         once the project has been restored.
         Package=false is load-bearing: a global -p:Package=true would otherwise flow through
         Steam's ProjectReference build of Core, run Core's Package target BEFORE Steam has
         compiled, and trip the "CardShopCoop.Steam.dll was not found" guard. -->
    <Exec Command="dotnet restore &quot;$(MSBuildThisFileDirectory)..\CardShopCoop.Steam\CardShopCoop.Steam.csproj&quot;"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\CardShopCoop.Steam\obj\project.assets.json')"
          StandardOutputImportance="low" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\CardShopCoop.Steam\CardShopCoop.Steam.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Deploy=$(Deploy);DeployPath=$(DeployPath);Package=false;SkipOptionalSteamBuild=true" />
  </Target>

</Project>
