<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CardShopCoop.Api</AssemblyName>
    <AssemblyTitle>CardShopCoop.Api</AssemblyTitle>
    <RootNamespace>CardShopCoop.Api</RootNamespace>
    <Company>DeliriumPulse</Company>
    <Product>CardShopCoop.Api</Product>
    <Description>Public integration contract for CardShopCoop. Optional-dependency safe.</Description>
    <Authors>DeliriumPulse</Authors>
    <Version>$(CardShopCoopVersion)</Version>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ManagedPath>$(GamePath)/Card Shop Simulator_Data/Managed</ManagedPath>
    <BepInExPath>$(GamePath)/BepInEx/core</BepInExPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="Package" AfterTargets="Build" Condition="'$(Package)' == 'true'">
    <PropertyGroup>
      <PackageDirectory>$(IntermediateOutputPath)package</PackageDirectory>
      <PackageZip>$(OutputPath)$(AssemblyName)-$(CardShopCoopVersion).zip</PackageZip>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageDirectory)" />
    <MakeDir Directories="$(PackageDirectory)/$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDirectory)/$(AssemblyName)" />
    <ZipDirectory SourceDirectory="$(PackageDirectory)" DestinationFile="$(PackageZip)" Overwrite="true" />
  </Target>

</Project>
